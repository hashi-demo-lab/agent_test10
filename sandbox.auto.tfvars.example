# Example variable values for sandbox testing
# Copy this file to sandbox.auto.tfvars and update with actual values

# AWS Region
region = "ap-southeast-2"

# Environment
environment = "development"

# EC2 Instance Configuration
instance_type = "t3.micro" # Or "t4g.micro" for 20% cost savings with Graviton

# =============================================================================
# ACM Certificate Configuration
# =============================================================================

# Option 1: Create a new ACM certificate via Terraform (Recommended for testing)
create_certificate = true
domain_name        = "*.example.com" # Change to your domain or keep for testing

# Option 2: Use an existing ACM certificate
# create_certificate = false
# certificate_arn    = "arn:aws:acm:ap-southeast-2:ACCOUNT_ID:certificate/CERTIFICATE_ID"

# Note: If create_certificate = true, Terraform will output DNS validation records.
# You must add these records to your DNS provider to complete certificate validation.
# The ALB will not work until the certificate is in ISSUED status.

# =============================================================================
# Infrastructure Configuration
# =============================================================================

# Availability Zones for Multi-AZ Deployment
availability_zones = ["ap-southeast-2a", "ap-southeast-2b"]

# Common Tags
common_tags = {
  ManagedBy   = "Terraform"
  Application = "ec2-alb-nginx"
  Owner       = "your-email@example.com"
  CostCenter  = "Engineering"
}
